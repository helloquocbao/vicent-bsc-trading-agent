# =============================================================================
# VICENT — environment variables template
# Copy to `.env` and fill in values. DO NOT commit `.env`.
# =============================================================================

# --- Wallet -------------------------------------------------------------------
PRIVATE_KEY=                          # 0x... EVM private key
WALLET_ADDRESS=                       # 0x... (auto-detects from private key if left empty)

# --- CMC ----------------------------------------------------------------------
# CMC_API_KEYS = comma-separated (key1,key2,key3) — auto-rotates when keys run out of credits
CMC_API_KEYS=
CMC_API_BASE=https://pro-api.coinmarketcap.com
CMC_MCP_URL=https://mcp.coinmarketcap.com/mcp
CMC_X402_ENABLED=false

# --- Strategy -----------------------------------------------------------------
VICENT_MODE=paper                     # paper | live
VICENT_STRATEGY=ensemble              # trend | meanrev | ensemble
VICENT_LOOP_INTERVAL_SEC=300
VICENT_MIN_TRADES_PER_DAY=2

# --- Risk guardrails ----------------------------------------------------------
RISK_MAX_DRAWDOWN_PCT=0.20
RISK_DAILY_LOSS_PCT=0.05
RISK_PER_TRADE_NAV_PCT=0.20
RISK_MAX_SLIPPAGE_BPS=80
RISK_MIN_LIQUIDITY_USD=250000

# --- Hyperliquid --------------------------------------------------------------
HL_TESTNET=false                      # false = mainnet, true = testnet
HL_ENABLED=true

# --- Database -----------------------------------------------------------------
# SQLite DB file path (auto-created on first run — no manual setup needed)
# *.db files are excluded from git intentionally (see .gitignore)
VICENT_DB_PATH=vicent_spot_trades.db

# --- Server -------------------------------------------------------------------
VICENT_SERVER_HOST=127.0.0.1
VICENT_SERVER_PORT=8080
LOG_LEVEL=INFO
